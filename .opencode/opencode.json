{
  "$schema": "https://opencode.ai/config.json",

  "model": "deepseek/deepseek-v4-flash",
  "small_model": "glm/glm-4.7-flash",
  "default_agent": "harness",

  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 2,
    "preserve_recent_tokens": 8000
  },

  "provider": {
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek",
      "env": ["DEEPSEEK_API_KEY"],
      "options": { "baseURL": "https://api.deepseek.com/v1" },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "reasoning": true,
          "interleaved": { "field": "reasoning_content" },
          "temperature": false,
          "tool_call": true,
          "limit": { "context": 1000000, "output": 384000 }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "reasoning": true,
          "interleaved": { "field": "reasoning_content" },
          "temperature": false,
          "tool_call": true,
          "limit": { "context": 1000000, "output": 384000 }
        }
      }
    },

    "glm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Z.ai / GLM",
      "env": ["ZAI_API_KEY", "Z_AI_API_KEY", "GLM_API_KEY", "ZHIPUAI_API_KEY"],
      "options": { "baseURL": "https://api.z.ai/api/paas/v4" },
      "models": {
        "glm-5.2": {
          "name": "GLM 5.2",
          "reasoning": true,
          "interleaved": { "field": "reasoning_content" },
          "temperature": true,
          "tool_call": true,
          "limit": { "context": 1000000, "output": 131072 }
        },
        "glm-5.1": {
          "name": "GLM 5.1",
          "reasoning": true,
          "interleaved": { "field": "reasoning_content" },
          "temperature": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 131072 }
        },
        "glm-5": {
          "name": "GLM 5",
          "reasoning": true,
          "interleaved": { "field": "reasoning_content" },
          "temperature": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 131072 }
        },
        "glm-4.7-flash": {
          "name": "GLM 4.7 Flash (free)",
          "reasoning": true,
          "interleaved": { "field": "reasoning_content" },
          "temperature": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 131072 }
        }
      }
    },

    "qwen": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Alibaba Qwen",
      "env": ["DASHSCOPE_API_KEY", "QWEN_API_KEY"],
      "options": { "baseURL": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1" },
      "models": {
        "qwen3.7-plus": {
          "name": "Qwen 3.7 Plus",
          "reasoning": true,
          "interleaved": { "field": "reasoning_content" },
          "temperature": true,
          "tool_call": true,
          "limit": { "context": 1000000, "output": 65536 }
        },
        "qwen3.7-max": {
          "name": "Qwen 3.7 Max",
          "reasoning": true,
          "interleaved": { "field": "reasoning_content" },
          "temperature": true,
          "tool_call": true,
          "limit": { "context": 1000000, "output": 65536 }
        },
        "qwen3.6-flash": {
          "name": "Qwen 3.6 Flash",
          "reasoning": true,
          "interleaved": { "field": "reasoning_content" },
          "temperature": true,
          "tool_call": true,
          "limit": { "context": 1000000, "output": 65536 }
        },
        "qwen3-coder-next": {
          "name": "Qwen3 Coder Next",
          "reasoning": true,
          "interleaved": { "field": "reasoning_content" },
          "temperature": true,
          "tool_call": true,
          "limit": { "context": 262144, "output": 65536 }
        }
      }
    },

    "kimi": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Moonshot Kimi",
      "env": ["MOONSHOT_API_KEY", "KIMI_API_KEY"],
      "options": { "baseURL": "https://api.moonshot.ai/v1" },
      "models": {
        "kimi-k3": {
          "name": "Kimi K3",
          "reasoning": true,
          "interleaved": { "field": "reasoning_content" },
          "temperature": false,
          "tool_call": true,
          "limit": { "context": 1000000, "output": 131072 }
        },
        "kimi-k2.7-code": {
          "name": "Kimi K2.7 Code",
          "reasoning": true,
          "interleaved": { "field": "reasoning_content" },
          "temperature": false,
          "tool_call": true,
          "limit": { "context": 262144, "output": 131072 }
        },
        "kimi-k2.7-code-highspeed": {
          "name": "Kimi K2.7 Code (High Speed)",
          "reasoning": true,
          "interleaved": { "field": "reasoning_content" },
          "temperature": false,
          "tool_call": true,
          "limit": { "context": 262144, "output": 131072 }
        },
        "kimi-k2.6": {
          "name": "Kimi K2.6",
          "reasoning": true,
          "interleaved": { "field": "reasoning_content" },
          "temperature": true,
          "tool_call": true,
          "limit": { "context": 262144, "output": 32768 }
        }
      }
    },

    "inferx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "InferX",
      "env": ["INFERX_API_KEY"],
      "options": { "baseURL": "https://model.inferx.net/endpoints/v1" },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash (InferX)",
          "tool_call": true,
          "limit": { "context": 262144, "output": 8192 }
        },
        "glm-52": {
          "name": "GLM 5.2 (InferX)",
          "tool_call": true,
          "limit": { "context": 262144, "output": 8192 }
        },
        "deepseek-v4-flash-0731": {
          "name": "DeepSeek V4 Flash 0731 (InferX)",
          "tool_call": true,
          "limit": { "context": 262144, "output": 8192 }
        }
      }
    },

    "tokenrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "TokenRouter",
      "env": ["TOKENROUTER_API_KEY"],
      "options": { "baseURL": "https://api.tokenrouter.com/v1" },
      "models": {
        "moonshotai/kimi-k3-free": {
          "name": "Kimi K3 (free, via TokenRouter)",
          "tool_call": true,
          "limit": { "context": 262144, "output": 8192 }
        }
      }
    },

    "nvidia": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NVIDIA NIM",
      "env": ["NVIDIA_API_KEY", "NVIDIA_NIM_API_KEY"],
      "options": { "baseURL": "https://integrate.api.nvidia.com/v1" },
      "models": {
        "z-ai/glm-5.2": {
          "name": "GLM 5.2 (free, via NVIDIA NIM)",
          "reasoning": true,
          "interleaved": { "field": "reasoning_content" },
          "temperature": true,
          "tool_call": true,
          "limit": { "context": 1000000, "output": 131072 }
        }
      }
    }
  },

  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8192
  },

  "mcp": {
    "claude-bridge": {
      "type": "local",
      "command": ["node", ".opencode/mcp/claude-bridge/server.mjs"],
      "enabled": false
    }
  }
}
